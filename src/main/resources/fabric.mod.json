{
  "schemaVersion": 1,
  "id": "truevision",
  "version": "1.0.0",
  "name": "TrueVision",
  "description": "Client-side Minecraft 26.3 mod that reveals invisible players and mobs using the native Render State pipeline. Works on all multiplayer servers and singleplayer worlds with full Sodium, Iris, ImmediatelyFast, and ViaFabricPlus compatibility.",
  "authors": [
    "Kazim"
  ],
  "contact": {
    "homepage": "https://github.com/Qazcto7/TrueVision",
    "sources": "https://github.com/Qazcto7/TrueVision",
    "issues": "https://github.com/Qazcto7/TrueVision/issues"
  },
  "license": "MIT",
  "icon": "assets/truevision/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.truevision.TrueVisionClient"
    ]
  },
  "mixins": [
    "truevision.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "sodium": "*",
    "iris": "*",
    "immediatelyfast": "*"
  }
}
